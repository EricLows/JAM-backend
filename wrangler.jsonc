{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jam-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"alias": {
		"@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js",
	},
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"CORS_ORIGIN_URL": "https://jam-pscb.com.br",
		"DEFAULT_ACCOUNT_EMAIL": "jam.10.scb@gmail.com",
		"DEFAULT_ACCOUNT_NAME": "JAM admin",
		"R2_BUCKET":"jam-files",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "99442292c66b442c98a0642061b7d5e7"
		}
	]
}